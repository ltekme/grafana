loki.source.syslog "syslog" {
  listener {
    address = "0.0.0.0:514"
    protocol = "udp"
    labels = { component = "loki.source.syslog", protocol = "udp", service = "syslog-default"}
    rfc3164_default_to_current_year = true
    syslog_format = "rfc3164"
  }

  forward_to = [
    loki.write.local.receiver,
    // loki.echo.console.receiver,
  ]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// loki.echo "console" { }